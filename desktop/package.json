{
  "name": "jpos-desktop",
  "productName": "J-POS",
  "version": "1.34.0",
  "description": "J-POS untuk laptop: kasir, stok, akuntansi, grosir & distributor",
  "author": "J-POS",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "id.jpos.desktop",
    "productName": "J-POS",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icons/icon-512.png",
      "artifactName": "J-POS-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "J-POS",
      "artifactName": "J-POS-Setup-${version}.${ext}",
      "unicode": true
    },
    "portable": {
      "artifactName": "J-POS-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "app/icons/icon-512.png",
      "category": "Office",
      "artifactName": "J-POS-${version}.${ext}"
    }
  }
}
