<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">

        <ImageView android:layout_width="104dp" android:layout_height="104dp"
            android:src="@drawable/ic_logo" android:elevation="12dp" android:layout_marginTop="24dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="JKam" android:textSize="34sp" android:textStyle="bold" android:textColor="@color/tx"
            android:layout_marginTop="14dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Rekam suara jernih 24 jam" android:textColor="@color/mut" android:layout_marginBottom="24dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp">

            <LinearLayout android:id="@+id/serverBox" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/JKam.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:text="Alamat server" />
                <EditText android:id="@+id/server" style="@style/JKam.Input"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="https://jkam-api.xxx.workers.dev" android:inputType="textUri" />
            </LinearLayout>

            <TextView style="@style/JKam.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Username" />
            <EditText android:id="@+id/username" style="@style/JKam.Input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="dari owner Anda" android:inputType="textNoSuggestions" />

            <TextView style="@style/JKam.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Password" />
            <EditText android:id="@+id/password" style="@style/JKam.Input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" />

            <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/bad" android:layout_marginTop="10dp" android:visibility="gone" />

            <Button android:id="@+id/login" style="@style/JKam.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="Masuk" />
            <ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="center" android:layout_marginTop="10dp" android:visibility="gone" />
        </LinearLayout>

        <TextView android:id="@+id/changeServer" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ubah alamat server" android:textColor="@color/mut" android:padding="14dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/mut" android:textSize="12sp"
            android:text="Akun dibuat oleh Owner melalui aplikasi JKam Owner." />
    </LinearLayout>
</ScrollView>
