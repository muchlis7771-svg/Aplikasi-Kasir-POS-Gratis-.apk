<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg" android:padding="14dp">

    <!-- Layar hasil -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|end"
        android:paddingHorizontal="12dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/expr" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="22sp" android:textColor="@color/mut" android:maxLines="1" android:ellipsize="start" />
        <TextView android:id="@+id/screen" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textSize="60sp" android:textStyle="bold" android:textColor="@color/tx"
            android:maxLines="1" android:ellipsize="start" android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Tombol -->
    <GridLayout android:id="@+id/pad" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:columnCount="4" android:rowCount="5" android:useDefaultMargins="false" />
</LinearLayout>
