{
  "name": "jpos-app",
  "version": "1.0.0",
  "private": true,
  "description": "J-POS: POS grosir multi-user online/offline (Android via Capacitor)",
  "scripts": {
    "android:add": "cap add android && node scripts/patch-android.js && python3 scripts/make-icons.py",
    "android:sync": "cap sync android && node scripts/patch-android.js",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/geolocation": "7.1.8",
    "@capacitor/share": "7.0.4",
    "@capacitor-mlkit/barcode-scanning": "7.5.0",
    "@capacitor/app": "7.1.2",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor-community/bluetooth-le": "7.3.2",
    "@capacitor/app-launcher": "7.0.4",
    "@capgo/capacitor-native-biometric": "7.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9"
  }
}